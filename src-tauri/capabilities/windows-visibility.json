{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-visibility",
  "description": "Floating-window transactions hide windows while moving/resizing and reveal them after ready.",
  "platforms": ["windows", "linux"],
  "windows": ["main", "strip"],
  "permissions": [
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
